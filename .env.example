# ==============================================================================
# HackerRank Campus Crew — Amrapali University, Haldwani
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env`:
#      cp .env.example .env
# 2. Fill in your real API keys and credentials below.
# 3. Never commit `.env` to Git (it is already included in .gitignore).
# ==============================================================================

# Server Port & Admin Authentication
PORT=3000
ADMIN_PASSWORD=amrapali2026

# ==============================================================================
# 1. Resend API Email Service (Recommended - https://resend.com)
# Free tier includes 3,000 emails/month with real-time delivery and analytics.
# Get API Key: https://resend.com/api-keys
# ==============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Custom Sender (Optional):
# - Default development test sender: onboarding@resend.dev
# - Production verified domain (e.g., support@amrapali.ac.in):
# RESEND_FROM=HackerRank Campus Crew <onboarding@resend.dev>

# ==============================================================================
# 2. Gmail / Custom SMTP Settings (Alternative Email Transport)
# Google Account Security: https://myaccount.google.com/apppasswords
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=your_email@gmail.com

# ==============================================================================
# 3. Google Firebase Firestore Settings (Cloud Database)
# ==============================================================================
FIREBASE_PROJECT_ID=hackerrank-campus-crew
# FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# ==============================================================================
# 4. Indian Mobile SMS & OTP Gateways (Optional)
# ==============================================================================
# Fast2SMS (Free / Instant Quick OTP - https://www.fast2sms.com)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio SMS (+91 Indian number format)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
