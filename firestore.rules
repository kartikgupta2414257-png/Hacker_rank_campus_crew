rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Applications collection: candidates can submit their coordinator applications & track status
    match /applications/{appId} {
      allow read: if true;
      allow create: if request.resource.data.email != null;
      allow update, delete: if true;
    }
    
    // Public chapters, events, hackathons, quizzes, and announcements
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
